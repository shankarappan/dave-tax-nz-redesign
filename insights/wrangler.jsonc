{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davetax-owner-insights",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "insights.davetaxnz.nz", "custom_domain": true }],
  "secrets": { "required": ["GOOGLE_SERVICE_ACCOUNT_JSON", "ALLOWED_EMAILS"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "GA_PROPERTY_ID": "552154177",
    "SEARCH_CONSOLE_SITE": "sc-domain:davetaxnz.nz",
    "DASHBOARD_ORIGIN": "https://insights.davetaxnz.nz",
    "CF_ACCESS_TEAM_DOMAIN": "fancy-term-dd58.cloudflareaccess.com",
    "CF_ACCESS_AUD": "2d8533b095804f05eb8fe7d9305bf41e898a44967b6944269a95616970362c9b",
    "GA_COLLECTION_START": "2026-08-31",
    "SITE_CUTOVER_DATE": "2026-08-20",
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
